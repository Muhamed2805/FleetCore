# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Secret keys tab in Project Settings > API. Bypasses RLS —
# only ever used server-side (the reminders cron route). Never expose to
# the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the reminders cron job must send as `Authorization: Bearer
# <value>` — generate any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Optional — resend.com API key. Reminder emails are skipped (logged only)
# until this is set.
RESEND_API_KEY=
